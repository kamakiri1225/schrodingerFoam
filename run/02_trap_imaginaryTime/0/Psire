/*--------------------------------*- C++ -*----------------------------------*\
| Psire -- Gaussian starting guess for imaginary-time relaxation              |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Psire;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   #codeStream
{
    codeInclude
    #{
        #include "fvCFD.H"
    #};
    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude -I$(LIB_SRC)/meshTools/lnInclude
    #};
    codeLibs
    #{
        -lfiniteVolume -lmeshTools
    #};
    code
    #{
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());
        const scalar sigma = 3.0;
        scalarField psi(mesh.nCells());
        forAll(psi, i)
        {
            const scalar x = mesh.C()[i].x();
            const scalar y = mesh.C()[i].y();
            psi[i] = Foam::exp(-(x*x + y*y)/(2.0*sigma*sigma));
        }
        psi.writeEntry("", os);
    #};
};

boundaryField
{
    walls
    {
        type            fixedValue;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
