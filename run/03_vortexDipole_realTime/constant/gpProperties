FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      gpProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Diffusion coefficient  D = hbar / (2 m)
D               D  [0 2 -1 0 0 0 0]  0.5;

// Non-linear coupling constant  g  (repulsive if > 0)
g               g  [0 0 -1 0 0 0 0]  1.0;

// Time-integration mode: realTime | imaginaryTime
mode            realTime;

// Crank-Nicolson Picard iterations (realTime)
nCorrectors     4;

// Renormalisation (mainly for imaginaryTime ground-state search)
normalize       false;
targetNorm      1.0;

// Stop when the field stops changing (imaginaryTime relaxation). 0 = never.
convergenceTol  0;

// Chemical-potential subtraction in realTime: solve i dPsi/dt = (H - mu) Psi
// to move into the frame co-rotating with the background phase e^{-i mu t},
// so the PHASE plot no longer flickers. Density/vortex dynamics are unchanged.
//   dynamicMu true  -> recompute mu = <Psi|H|Psi>/<Psi|Psi> each step
//   dynamicMu false -> subtract the constant muShift below
// Uniform bulk here has n0 = 1, g = 1, so mu = g*n0 = 1.
dynamicMu       false;
muShift         1.0;

// ************************************************************************* //
