/*--------------------------------*- C++ -*----------------------------------*\
| Psiim -- zero imaginary part (no perturbation / no noise)                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Psiim;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    down
    {
        type            cyclic;
    }
    up
    {
        type            cyclic;
    }
    frontAndBack
    {
        type            empty;
    }
}

