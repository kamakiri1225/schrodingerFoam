/*--------------------------------*- C++ -*----------------------------------*\
| controlDict -- 1D harmonic oscillator, real-time coherent-state oscillation |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     schrodingerFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         12.566;   // two oscillation periods, T = 2*pi/omega = 6.283

deltaT          0.005;    // dt < dx^2/D = 0.02 for the split-explicit Laplacian

writeControl    runTime;
writeInterval   0.1;      // ~126 output frames

purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
