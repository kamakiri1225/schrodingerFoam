/*--------------------------------*- C++ -*----------------------------------*\
| Psiim -- coherent state starts at rest (zero momentum) => imaginary part = 0  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Psiim;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            fixedValue;
        value           uniform 0;
    }
    right
    {
        type            fixedValue;
        value           uniform 0;
    }
    emptyY
    {
        type            empty;
    }
    frontAndBack
    {
        type            empty;
    }
}

