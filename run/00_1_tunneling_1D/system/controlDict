/*--------------------------------*- C++ -*----------------------------------*\
| controlDict -- 1D tunneling, real-time evolution                            |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     schrodingerFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         22;      // packet reaches the barrier near t~10, then splits

deltaT          0.01;    // dt < dx^2/D = 0.08 for the split-explicit Laplacian

writeControl    runTime;
writeInterval   0.5;     // ~44 output frames

purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
