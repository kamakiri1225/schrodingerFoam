/*--------------------------------*- C++ -*----------------------------------*\
| blockMeshDict -- 2D box for anisotropic wave-packet release                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0; format ascii; class dictionary; object blockMeshDict;
}

scale 1;
Lx 20; Ly 20; dz 0.2;
nx 200; ny 200;

vertices
(
    (-$Lx -$Ly 0)    ( $Lx -$Ly 0)
    ( $Lx  $Ly 0)    (-$Lx  $Ly 0)
    (-$Lx -$Ly $dz)  ( $Lx -$Ly $dz)
    ( $Lx  $Ly $dz)  (-$Lx  $Ly $dz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny 1) simpleGrading (1 1 1)
);

edges ();

boundary
(
    left  { type patch; faces ((0 4 7 3)); }
    right { type patch; faces ((1 2 6 5)); }
    down  { type patch; faces ((0 1 5 4)); }
    up    { type patch; faces ((3 7 6 2)); }
    frontAndBack
    {
        type empty;
        faces ((0 3 2 1) (4 5 6 7));
    }
);

mergePatchPairs ();

// ************************************************************************* //
