FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Psire;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   #codeStream
{
    codeInclude
    #{
        #include "fvCFD.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
        -I$(LIB_SRC)/meshTools/lnInclude
    #};

    codeLibs
    #{
        -lfiniteVolume \
        -lmeshTools
    #};

    code
    #{
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        // --- dark-soliton pair with a transverse (snake) perturbation ---
        const scalar w     = 1.0;   // soliton width ( = sqrt(2)*xi )
        const scalar x0    = 6.0;   // half-separation of the two grooves
        const scalar A     = 0.25;  // perturbation amplitude
        const scalar lamY  = 8.0;   // transverse perturbation wavelength
        const scalar twoPi = constant::mathematical::twoPi;

        scalarField psi(mesh.nCells());
        forAll(psi, i)
        {
            const scalar x = mesh.C()[i].x();
            const scalar y = mesh.C()[i].y();
            const scalar sh = A*Foam::cos(twoPi*y/lamY);   // node displacement
            psi[i] =
                Foam::tanh((x + x0 - sh)/w)
              * Foam::tanh((x - x0 - sh)/w);
        }

        psi.writeEntry("", os);
    #};
};

boundaryField
{
    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    down
    {
        type            cyclic;
    }
    up
    {
        type            cyclic;
    }
    frontAndBack
    {
        type            empty;
    }
}

