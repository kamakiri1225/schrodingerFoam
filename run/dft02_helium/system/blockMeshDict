FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// Hydrogen atom in a [-12,12]^3 Bohr box, uniform 64^3.
L    12;
N    64;

scale 1;

vertices
(
    (-$L -$L -$L)
    ( $L -$L -$L)
    ( $L  $L -$L)
    (-$L  $L -$L)
    (-$L -$L  $L)
    ( $L -$L  $L)
    ( $L  $L  $L)
    (-$L  $L  $L)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($N $N $N) simpleGrading (1 1 1)
);

boundary
(
    outer
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);
