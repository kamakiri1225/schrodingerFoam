FoamFile { version 2.0; format ascii; class volScalarField; object VH; }
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    outer
    {
        type            fixedValue;
        value           #codeStream
        {
            codeInclude #{ #include "fvCFD.H" #};
            codeOptions #{ -I$(LIB_SRC)/finiteVolume/lnInclude -I$(LIB_SRC)/meshTools/lnInclude #};
            codeLibs    #{ -lfiniteVolume -lmeshTools #};
            code
            #{
                // Monopole (far-field) Hartree BC:  VH = Ne / r
                // NOTE: inside boundaryField the local dict is the patch
                // sub-dictionary, so climb to the field's top dictionary.
                const dictionary& topDict = dict.topDict();
                const IOdictionary& d =
                    static_cast<const IOdictionary&>(topDict);
                const fvMesh& mesh = refCast<const fvMesh>(d.db());
                const label patchi = mesh.boundaryMesh().findPatchID("outer");
                const vectorField& Cf = mesh.boundary()[patchi].Cf();
                const scalar Ne = 2.0;
                scalarField v(Cf.size());
                forAll(v, i)
                {
                    v[i] = Ne/mag(Cf[i]);
                }
                v.writeEntry("", os);
            #};
        };
    }
}
