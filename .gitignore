# ---- OpenFOAM run output (heavy / regenerable) ----
# time-step directories (keep the initial condition dir "0")
run/*/[1-9]*/
run/*/0.*/
run/*/VTK/
run/*/processor*/
run/*/postProcessing/
run/*/dynamicCode/
run/*/constant/polyMesh/
run/*/*.orig/
run/*/log.*

# animation frame sequences (keep only the compressed .gif)
run/*/ani/
figures/*/frames/
figures/*/*frames/

# ---- solver build artifacts ----
schrodingerFoam/Make/*/
schrodingerFoam/lnInclude/
**/*.o
**/*.so
**/linux*Opt/

# ---- heavy reference material (downloadable elsewhere) ----
docs/*
!docs/research_plan_2D_quantum_turbulence_free_expansion.md
# --- slide deck for GitHub Pages (keep tracked) ---
!docs/slides_schrodingerFoam.html
!docs/*.png
!docs/book_*.jpg
!docs/note_prev_attempt.gif
!docs/古典_量子乱流.png
figures/00_reference/ref_kamakiri_animate_full.gif

# ---- misc ----
*.pyc
__pycache__/
